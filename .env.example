# Copy to .env and adjust as needed: `cp .env.example .env`
# The dev project (src/dev/settings.py) runs with sane defaults even if
# you skip this entirely - SECRET_KEY/TIME_ZONE fall back to dev-only
# values, ALLOWED_HOSTS/CORS/CSRF fall back to permissive dev defaults,
# and the database defaults to a local sqlite file. This file is only
# needed to customize any of that, or to point at a real Postgres database.

# --------------------------
# Core
# --------------------------
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=1
TIME_ZONE=UTC
DOCKER=NO
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------
# Networking
# --------------------------
PORT=7002
START_API_URL=http://localhost:7002/api/

# --------------------------
# Database (defaults to a local sqlite3 file if unset)
# --------------------------
# SQL_ENGINE=postgresql
# SQL_DATABASE=django_resaas
# SQL_USER=user
# SQL_PASSWORD=password
# SQL_HOST=localhost
# SQL_PORT=5432

# --------------------------
# CORS / CSRF (comma-separated, e.g. http://localhost:9000)
# --------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_HEADERS=
CSRF_TRUSTED_ORIGINS=

# --------------------------
# Static / Media
# --------------------------
STATIC_URL=static
MEDIA_URL=media

# --------------------------
# Email (optional)
# --------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_SSL=
# EMAIL_USE_TLS=
